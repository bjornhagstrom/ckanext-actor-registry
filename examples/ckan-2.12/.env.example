# Copy to .env (or run ./setup.sh, which does that and fills in random secrets).
# Never commit .env.

# CKAN release: 2.12, 2.11 (the newest 2.11 patch) or a specific version such as 2.11.1
# (2.11.1 is the oldest supported). The Solr image only has a tag per release LINE, so
# for a specific patch version also set SOLR_VERSION=2.11 (or 2.12).
CKAN_VERSION=2.12
# SOLR_VERSION=2.11
# Latest ckanext-scheming release. See docs/INSTALLATION.md.
SCHEMING_SPEC=ckanext-scheming==3.1.0

# Where CKAN is reachable from your browser. Change both if you change the port.
CKAN_PORT=5000
CKAN_SITE_URL=http://localhost:5000

# Secrets -- setup.sh generates these. Do not use the placeholders.
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me
JWT_SECRET=change-me

# The sysadmin account created on first start.
CKAN_SYSADMIN_NAME=admin
CKAN_SYSADMIN_PASSWORD=change-me
CKAN_SYSADMIN_EMAIL=admin@example.org

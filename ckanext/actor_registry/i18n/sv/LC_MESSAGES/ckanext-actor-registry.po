msgstr "Välj vad som ska göras med de valda datamängderna."

#: ckanext/actor_registry/contact_migration.py:368
msgid "Select at least one dataset that still needs a contact point."
msgstr "Välj minst en datamängd som fortfarande behöver en kontaktpunkt."

#: ckanext/actor_registry/contact_migration.py:412
msgid "Choose an active contact point."
msgstr "Välj en aktiv kontaktpunkt."

#: ckanext/actor_registry/contact_migration.py:426
msgid "Choose what to do with the change."
msgstr "Välj vad som ska göras med ändringen."

#: ckanext/actor_registry/contact_migration.py:429
msgid "The dataset is no longer among the changed ones."
msgstr "Datamängden finns inte längre bland de ändrade."

#: ckanext/actor_registry/contact_migration.py:441
msgid ""
"The contact point it was linked to is no longer in use on this dataset. "
"Link another one instead."
msgstr ""
"Kontaktpunkten den kopplades till används inte längre på datamängden. "
"Koppla en annan i stället."

#: ckanext/actor_registry/contact_migration.py:476
#: ckanext/actor_registry/views.py:798
#, python-brace-format
msgid "Could not link {title}: {message}"
msgstr "Kunde inte koppla {title}: {message}"

#: ckanext/actor_registry/contact_migration.py:531
msgid ""
"Some datasets still have no contact point or have unhandled changes. "
"Confirm that you want to close the migration anyway."
msgstr ""
"Några datamängder saknar fortfarande kontaktpunkt eller har ändringar som"
" inte hanterats. Bekräfta att du ändå vill avsluta migreringen."

#: ckanext/actor_registry/validation.py:67
#, python-brace-format
msgid "{field} is too long: at most {max} characters."
msgstr "{field} är för långt: högst {max} tecken."

#: ckanext/actor_registry/validation.py:81
msgid "Enter a valid email address, for example name@example.org."
msgstr "Ange en giltig e-postadress, till exempel namn@example.org."

#: ckanext/actor_registry/validation.py:99
msgid "Enter a full web address starting with http:// or https://."
msgstr "Ange en fullständig webbadress som börjar med http:// eller https://."

#: ckanext/actor_registry/validation.py:114
msgid "Enter an absolute URI starting with http://, https:// or urn:."
msgstr "Ange en absolut URI som börjar med http://, https:// eller urn:."

#: ckanext/actor_registry/validation.py:125
msgid "Enter a phone number using digits, spaces and the characters + ( ) - only."
msgstr "Ange ett telefonnummer med endast siffror, mellanslag och tecknen + ( ) -."

#: ckanext/actor_registry/validation.py:132
msgid "The kind must be either organization or person."
msgstr "Slaget måste vara antingen organisation eller person."

#: ckanext/actor_registry/validation.py:217
msgid "Identifier and identifier scheme must be filled in together."
msgstr "Identifierare och identifierarsystem måste anges tillsammans."

#: ckanext/actor_registry/validation.py:223
#, python-brace-format
msgid ""
"The identifier \"{identifier}\" with scheme \"{scheme}\" is already used "
"by the publisher \"{name}\"."
msgstr ""
"Identifieraren \"{identifier}\" med systemet \"{scheme}\" används redan "
"av utgivaren \"{name}\"."

#: ckanext/actor_registry/validation.py:238
msgid "The selected organization does not exist or is no longer active."
msgstr "Den valda organisationen finns inte eller är inte längre aktiv."

#: ckanext/actor_registry/validators.py:32
#, python-brace-format
msgid ""
"The selected publisher no longer exists (id {id}). Choose another "
"publisher."
msgstr "Den valda utgivaren finns inte längre (id {id}). Välj en annan utgivare."

#: ckanext/actor_registry/validators.py:36
#, python-brace-format
msgid ""
"The publisher “{name}” is inactive and can no longer be chosen. Choose an"
" active publisher."
msgstr ""
"Utgivaren ”{name}” är inaktiv och kan inte längre väljas. Välj en aktiv "
"utgivare."

#: ckanext/actor_registry/validators.py:58
#, python-brace-format
msgid ""
"A selected contact point no longer exists (id {id}). Remove it from the "
"list."
msgstr "En vald kontaktpunkt finns inte längre (id {id}). Ta bort den ur listan."

#: ckanext/actor_registry/validators.py:62
#, python-brace-format
msgid ""
"The contact point “{name}” is inactive and can no longer be chosen. "
"Choose an active contact point."
msgstr ""
"Kontaktpunkten ”{name}” är inaktiv och kan inte längre väljas. Välj en "
"aktiv kontaktpunkt."


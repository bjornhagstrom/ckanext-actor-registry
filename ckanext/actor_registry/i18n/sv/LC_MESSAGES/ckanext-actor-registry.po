msgid "Name cannot be empty."
msgstr "Namn kan inte vara tomt."

#: ckanext/actor_registry/actions.py:71
msgid "The publisher to keep was not found, or is already inactive."
msgstr "Den kvarvarande utgivaren hittades inte eller är redan inaktiv."

#: ckanext/actor_registry/actions.py:75
msgid "The publisher to merge was not found, or is already inactive."
msgstr "Utgivaren som ska slås ihop hittades inte eller är redan inaktiv."


msgid "Unknown kind of reference."
msgstr "Okänd typ av hänvisning."

#: ckanext/actor_registry/cleanup.py:101
msgid "Choose what to replace it with."
msgstr "Välj vad den ska bytas till."

#: ckanext/actor_registry/cleanup.py:105
msgid "Choose a different record to replace it with."
msgstr "Välj en annan post att byta till."

#: ckanext/actor_registry/cleanup.py:110
msgid "Choose an active record to replace it with."
msgstr "Välj en aktiv post att byta till."

#: ckanext/actor_registry/cleanup.py:117
msgid "There is nothing to replace on the datasets you may edit."
msgstr "Det finns inget att byta på de datamängder du får redigera."


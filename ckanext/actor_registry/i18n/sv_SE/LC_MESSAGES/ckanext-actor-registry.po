#: ckanext/actor_registry/templates/actor_registry/actor_form.html:3
#: ckanext/actor_registry/templates/actor_registry/actor_show.html:3
#: ckanext/actor_registry/templates/actor_registry/actors_index.html:2
#: ckanext/actor_registry/templates/actor_registry/actors_index.html:3
#: ckanext/actor_registry/templates/actor_registry/actors_index.html:6
#: ckanext/actor_registry/templates/actor_registry/actors_merge.html:3
msgid "Publishers"
msgstr "Utgivare"

msgid "Delete publisher"
msgstr "Ta bort utgivare"

msgid ""
"This publisher is already merged and retired. It is kept around today "
"only so its web address (URI) keeps resolving, in case anything outside "
"this catalogue already links to it or has it cached. Deleting it removes "
"that address for good -- do this only once you are confident nothing "
"depends on it any more."
msgstr ""
"Den här utgivaren är redan sammanslagen och pensionerad. Den finns kvar "
"idag bara för att dess webbadress (URI) ska fortsätta fungera, om något "
"utanför katalogen redan länkar till den eller har cachat den. Att ta bort"
" den tar bort adressen för gott — gör det först när du är säker på att "
"inget längre är beroende av den."

#, python-brace-format
msgid ""
"{n} dataset(s) have this publisher. Their publisher will be cleared, not "
"reassigned."
msgstr ""
"{n} datamängd(er) har den här utgivaren. Deras utgivare rensas, den byts "
"inte ut."

#, python-brace-format
msgid ""
"{n} contact point(s) belong to this publisher and will become standalone "
"(not deleted, just no longer linked to an organization/person)."
msgstr ""
"{n} kontaktpunkt(er) tillhör den här utgivaren och blir fristående (de "
"tas inte bort, de är bara inte längre kopplade till en "
"organisation/person)."

#, python-brace-format
msgid ""
"{n} other publisher(s) were previously merged into this one. Their "
"\"merged with\" pointer will stop resolving once this record is gone."
msgstr ""
"{n} andra utgivare slogs tidigare ihop med den här. Deras hänvisning "
"\"sammanslagen med\" slutar fungera när den här posten är borttagen."

msgid ""
"No datasets, contact points, or other publishers currently depend on this"
" publisher."
msgstr ""
"Inga datamängder, kontaktpunkter eller andra utgivare är för närvarande "
"beroende av den här utgivaren."

msgid "Datasets with this publisher"
msgstr "Datamängder med den här utgivaren"

msgid "Contact points owned by this publisher"
msgstr "Kontaktpunkter som tillhör den här utgivaren"

msgid "Publishers previously merged into this one"
msgstr "Utgivare som tidigare slagits ihop med den här"

msgid "Yes, permanently delete this publisher"
msgstr "Ja, ta bort den här utgivaren permanent"

#, python-brace-format
msgid ""
"This contact point belongs to {actor}. That publisher is not affected by "
"deleting this contact point."
msgstr ""
"Den här kontaktpunkten tillhör {actor}. Den utgivaren påverkas inte av "
"att kontaktpunkten tas bort."

msgid "Show merged/retired publishers too"
msgstr "Visa även sammanslagna/pensionerade utgivare"

msgid ""
"Merging retires the losing publisher instead of deleting it, so its web "
"address (URI) keeps resolving if anything already links to or has cached "
"it -- its page simply points to the publisher it was merged into. Merged "
"publishers are hidden here by default to keep this list focused on "
"publishers still in use; check the box above to see them too, for example"
" before permanently deleting one you are sure is no longer needed."
msgstr ""
"Vid sammanslagning pensioneras den utgivare som väljs bort i stället för "
"att tas bort, så att dess webbadress (URI) fortsätter fungera om något "
"redan länkar till den eller har cachat den — dess sida pekar helt enkelt "
"på den utgivare den slogs ihop med. Sammanslagna utgivare är dolda här "
"som standard, för att listan ska hålla sig till utgivare som fortfarande "
"används; kryssa i rutan ovan för att visa dem också, till exempel innan "
"du tar bort en permanent som du är säker på inte behövs längre."

